# OralLink TaskFlow — Environment Variables
# Copy this to .env.local and fill in the values

# Airtable
AIRTABLE_API_KEY=           # Required — personal access token (pat...)
AIRTABLE_BASE_ID=appS0SeEmjrtNYcIG  # Optional — defaults to this in code

# Claude AI (Anthropic)
ANTHROPIC_API_KEY=          # Required — API key (sk-ant-...)

# Email (Resend)
RESEND_API_KEY=             # Required — API key (re_...)
RESEND_FROM_EMAIL=taskflow@orallink.health  # Optional — sender address

# Auth
JWT_SECRET=                 # Recommended — any strong random string

# Cron
CRON_SECRET=                # Required — bearer token for /api/cron

# Activity Log (auto-created via admin Settings page)
# AIRTABLE_ACTIVITY_TABLE_ID=  # Set after running activity table setup
